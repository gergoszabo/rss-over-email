{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sqlite": "Data Source=rss.db"
  },
  "RssOverEmail": {
    "Feeds": [
      {
        "Name": "Hacker News",
        "Url": "http://news.ycombinator.com/rss"
      }
    ],
    "FetchIntervalMinutes": 15
  }
}
